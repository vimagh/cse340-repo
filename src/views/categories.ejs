<%- include('partials/header') %>

<main>
    <section class="page-header">
        <h1><%= title %></h1>
        <p>Explore the categories of service projects available through our partner organizations.</p>
    </section>

    <section class="category-grid">
        <% categories.forEach(category => { %>
            <article class="card">
                <h2><%= category.name %></h2>
            </article>
        <% }); %>
    </section>
</main>

<%- include('partials/footer') %>